{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "760px", "wideSize": "1200px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "navy", "color": "#0B2D50", "name": "Navy" },
				{ "slug": "navy-deep", "color": "#071F38", "name": "Navy deep" },
				{ "slug": "gold", "color": "#F4B400", "name": "Gold" },
				{ "slug": "teal", "color": "#008FA8", "name": "Teal" },
				{ "slug": "teal-deep", "color": "#00687A", "name": "Teal deep" },
				{ "slug": "teal-soft", "color": "#E3F4F7", "name": "Teal soft" },
				{ "slug": "ink", "color": "#0F1E33", "name": "Ink" },
				{ "slug": "muted", "color": "#55657A", "name": "Muted" },
				{ "slug": "line", "color": "#D8E0E8", "name": "Line" },
				{ "slug": "paper", "color": "#F5F8FB", "name": "Paper" },
				{ "slug": "white", "color": "#FFFFFF", "name": "White" }
			],
			"gradients": [
				{ "slug": "night", "gradient": "linear-gradient(160deg, #0B2D50 0%, #071F38 100%)", "name": "Night" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{ "slug": "heading", "name": "Montserrat", "fontFamily": "Montserrat, system-ui, -apple-system, \"Segoe UI\", sans-serif" },
				{ "slug": "body", "name": "System sans", "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif" }
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "Small" },
				{ "slug": "medium", "size": "1.0625rem", "name": "Medium" },
				{ "slug": "large", "size": "1.25rem", "name": "Large", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
				{ "slug": "x-large", "size": "2.25rem", "name": "Extra large", "fluid": { "min": "1.625rem", "max": "2.25rem" } },
				{ "slug": "display", "size": "4rem", "name": "Display", "fluid": { "min": "2.375rem", "max": "4rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "size": "12px", "name": "XS" },
				{ "slug": "30", "size": "20px", "name": "S" },
				{ "slug": "40", "size": "clamp(24px, 3vw, 36px)", "name": "M" },
				{ "slug": "50", "size": "clamp(36px, 5vw, 64px)", "name": "L" },
				{ "slug": "60", "size": "clamp(56px, 8vw, 112px)", "name": "XL" }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
		"spacing": { "blockGap": "20px", "padding": { "left": "24px", "right": "24px" } },
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.65" },
		"elements": {
			"heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "700", "lineHeight": "1.12", "letterSpacing": "-0.02em" }, "color": { "text": "var(--wp--preset--color--navy)" } },
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)", "fontWeight": "800" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": { "color": { "text": "var(--wp--preset--color--teal-deep)" }, ":hover": { "color": { "text": "var(--wp--preset--color--navy)" } } },
			"button": {
				"color": { "background": "var(--wp--preset--color--gold)", "text": "var(--wp--preset--color--navy)" },
				"border": { "radius": "12px" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "700", "fontSize": "1rem" },
				"spacing": { "padding": { "top": "14px", "bottom": "14px", "left": "26px", "right": "26px" } },
				":hover": { "color": { "background": "#FFC629", "text": "var(--wp--preset--color--navy)" } }
			}
		},
		"blocks": {
			"core/navigation": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "600", "fontSize": "0.9375rem" }, "elements": { "link": { "color": { "text": "var(--wp--preset--color--navy)" }, "typography": { "textDecoration": "none" } } } },
			"core/separator": { "color": { "text": "var(--wp--preset--color--line)" } },
			"core/quote": { "border": { "left": { "color": "var(--wp--preset--color--gold)", "width": "4px", "style": "solid" } }, "spacing": { "padding": { "left": "20px" } } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-wide", "title": "Wide page (sermon library and showcase pages)", "postTypes": ["page"] },
		{ "name": "page-hands-on", "title": "Hands-on features (showcase)", "postTypes": ["page"] },
		{ "name": "page-import", "title": "Import (showcase)", "postTypes": ["page"] },
		{ "name": "page-beta", "title": "Beta tester sign-up", "postTypes": ["page"] }
	]
}
